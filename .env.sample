# MAiCampus environment configuration.
# Copy to `.env` and fill in the secrets:  cp .env.sample .env
# Docker Compose auto-loads `.env` for ${VAR} interpolation in docker-compose.yml.
# `.env` is gitignored; this `.env.sample` is committed as the template (no secrets).

# --- Google SSO (OAuth) ----------------------------------------------------
# Create an OAuth 2.0 Client (type: Web application) in Google Cloud Console.
# Add the redirect URL below to the client's "Authorized redirect URIs".
MAICAMPUS_GOOGLE_CLIENT_ID=
MAICAMPUS_GOOGLE_CLIENT_SECRET=
# Must exactly match an Authorized redirect URI on the OAuth client.
# Local web: http://localhost:8550/oauth_callback  ·  Prod (tunnel): https://<your-host>/oauth_callback
MAICAMPUS_GOOGLE_REDIRECT_URL=http://localhost:8550/oauth_callback
# Restrict sign-in to these email domains (subdomains included). Empty or "*" = any Google account.
MAICAMPUS_ALLOWED_EMAIL_DOMAINS=utm.my

# --- AI provider (single server-side key, shared by all users — for chat) --
# Default provider is DeepSeek. Set the API key to enable chat.
MAICAMPUS_AI_PROVIDER=deepseek
MAICAMPUS_AI_API_KEY=
# Optional model override (blank = provider default, e.g. deepseek-chat).
MAICAMPUS_AI_MODEL=

# --- AI memory embeddings (OpenAI embeddings API) --------------------------
# DeepSeek has no embeddings endpoint, so long-term memory embeds via OpenAI.
# Set an OpenAI key to enable memory; leave blank to run without it (chat still works).
MAICAMPUS_EMBED_API_KEY=
MAICAMPUS_EMBED_MODEL=text-embedding-3-small
MAICAMPUS_EMBED_DIM=1536
# MAICAMPUS_EMBED_BASE_URL=   # optional, for an OpenAI-compatible embeddings host

# --- Per-user daily message limit ------------------------------------------
MAICAMPUS_DAILY_LIMIT=50

# --- Server-side tracing ---------------------------------------------------
# Verbosity of server traces in `docker compose logs webapp`. DEBUG = very verbose
# (per-step auth + session detail); INFO = key events; WARNING = problems only.
MAICAMPUS_LOG_LEVEL=INFO

# --- Cloudflare Tunnel (optional) ------------------------------------------
# Token from a named tunnel in the Cloudflare Zero Trust dashboard. Run with:
#   docker compose --profile tunnel up -d --build
# In the dashboard, route the public hostname to  http://webapp:8550
MAICAMPUS_CF_TUNNEL_TOKEN=
